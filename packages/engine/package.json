{
  "name": "@room/engine",
  "version": "1.0.0",
  "description": "ROOM core engine and CLI",
  "license": "Apache-2.0",
  "main": "dist/src/index.js",
  "type": "module",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./modelCatalog": {
      "types": "./dist/src/modelCatalog.d.ts",
      "import": "./dist/src/modelCatalog.js",
      "default": "./dist/src/modelCatalog.js"
    },
    "./shellArgs": {
      "types": "./dist/src/shellArgs.d.ts",
      "import": "./dist/src/shellArgs.js",
      "default": "./dist/src/shellArgs.js"
    },
    "./agents/personaTemplates": {
      "types": "./dist/src/agents/personaTemplates.d.ts",
      "import": "./dist/src/agents/personaTemplates.js",
      "default": "./dist/src/agents/personaTemplates.js"
    }
  },
  "bin": {
    "room": "dist/bin/room.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.12",
    "vitest": "^3.2.6"
  }
}
