{
  "name": "@room/engine",
  "version": "1.0.0",
  "description": "ROOM core engine and CLI",
  "main": "dist/src/index.js",
  "type": "module",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./modelCatalog": {
      "types": "./dist/src/modelCatalog.d.ts",
      "import": "./dist/src/modelCatalog.js",
      "default": "./dist/src/modelCatalog.js"
    },
    "./shellArgs": {
      "types": "./dist/src/shellArgs.d.ts",
      "import": "./dist/src/shellArgs.js",
      "default": "./dist/src/shellArgs.js"
    }
  },
  "bin": {
    "room": "dist/bin/room.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/js-yaml": "^4.0.9"
  }
}
